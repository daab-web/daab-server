{"root":{"children":[{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Qeyri-xətti Analiz və Riyazi Fizikaya Töhfələri","type":"text","version":1}],"direction":null,"format":"justify","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"·Qeyri-xətti tənliklərin qlobal həlli üçün yeni topoloji invariantlar nəzəriyyəsini yaratmışdır.","type":"text","version":1}],"direction":null,"format":"start","indent":0,"type":"listitem","version":1,"value":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"·Bu invariantlar qeyri-xətti sistemlərin keyfiyyət dəyişikliklərinin (lokal və qlobal bifurkasiya) analizində mühüm rol oynayır.","type":"text","version":1}],"direction":null,"format":"start","indent":0,"type":"listitem","version":1,"value":2}],"direction":null,"format":"","indent":0,"type":"list","version":1,"listType":"bullet","start":1,"tag":"ul"},{"children":[],"direction":null,"format":"justify","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Riyazi Modelləşdirmə","type":"text","version":1}],"direction":null,"format":"justify","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Biologiya, tibb, ekologiya, mexanika və fizika sahələrində qarşılaşılan problemlərin riyazi modelləşdirilməsi üzrə fundamental tədqiqatlar aparmışdır.","type":"text","version":1}],"direction":null,"format":"start","indent":0,"type":"listitem","version":1,"value":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Təkamül tənliklərinə uyğun dinamik sistemlərin attraktorlarının yeni siniflərini yaratmış və onların sistematik şəkildə öyrənilməsinə mühüm töhfə vermişdir.","type":"text","version":1}],"direction":null,"format":"start","indent":0,"type":"listitem","version":1,"value":2}],"direction":null,"format":"","indent":0,"type":"list","version":1,"listType":"bullet","start":1,"tag":"ul"},{"children":[],"direction":null,"format":"justify","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Beynəlxalq Elmi Jurnallarda Fəaliyyəti","type":"text","version":1}],"direction":null,"format":"justify","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"children":[{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Ondan çox aparıcı beynəlxalq jurnalın redaksiya heyətinin üzvüdür.","type":"text","version":1}],"direction":null,"format":"","indent":1,"type":"listitem","version":1,"value":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"\"International Journal of Biomathematics and Biostatistics\" jurnalının baş redaktorudur.","type":"text","version":1}],"direction":null,"format":"","indent":1,"type":"listitem","version":1,"value":2}],"direction":null,"format":"","indent":0,"type":"list","version":1,"listType":"bullet","start":1,"tag":"ul"}],"direction":null,"format":"start","indent":0,"type":"listitem","version":1,"value":1}],"direction":null,"format":"","indent":0,"type":"list","version":1,"listType":"bullet","start":1,"tag":"ul"},{"children":[],"direction":null,"format":"justify","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Elmi Nəşrləri","type":"text","version":1}],"direction":null,"format":"justify","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Yaponiya, Almaniya, ABŞ, Kanada və İsveçrədə nəşr olunan 8 kitabın müəllifidir.","type":"text","version":1}],"direction":null,"format":"start","indent":0,"type":"listitem","version":1,"value":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"200-dən çox elmi məqalə yazmış, dünyanın 15 ölkəsindən həmmüəlliflərlə əməkdaşlıq etmişdir.","type":"text","version":1}],"direction":null,"format":"start","indent":0,"type":"listitem","version":1,"value":2}],"direction":null,"format":"","indent":0,"type":"list","version":1,"listType":"bullet","start":1,"tag":"ul"},{"children":[],"direction":null,"format":"justify","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Beynəlxalq Universitetlərdə Fəaliyyəti","type":"text","version":1}],"direction":null,"format":"justify","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"2018-ci ildə Kanada Toronto Universiteti və Fields İnstitutunda \"Dean’s Distinguished Visiting Professor\" kimi yüksək statusda 6 ay müddətində mühazirələr oxumuş və “Emerging Challenges in Mathematical Biology” tematik proqramının həyata keçirilməsində mühüm rol oynamışdır.","type":"text","version":1}],"direction":null,"format":"start","indent":0,"type":"listitem","version":1,"value":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"2019-cu ildə Vaterloo Universitetinə \"James D. Murray Distinguished Visiting Professor\" statusu ilə dəvət olunmuşdur.","type":"text","version":1}],"direction":null,"format":"start","indent":0,"type":"listitem","version":1,"value":2}],"direction":null,"format":"","indent":0,"type":"list","version":1,"listType":"bullet","start":1,"tag":"ul"},{"children":[],"direction":null,"format":"justify","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Mükafatlar və Təltiflər","type":"text","version":1}],"direction":null,"format":"justify","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"1991-ci ildə Almaniya hökumətinin təsis etdiyi \"Aleksandr fon Humboldt\" mükafatını qazanan ilk azərbaycanlı alim olmuşdur.","type":"text","version":1}],"direction":null,"format":"start","indent":0,"type":"listitem","version":1,"value":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"2005-ci ildə Yaponiyanın nüfuzlu \"Japan Society for the Promotion of Science - JSPS\" mükafatına layiq görülmüşdür.","type":"text","version":1}],"direction":null,"format":"start","indent":0,"type":"listitem","version":1,"value":2},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"2007-ci ildə Danimarka hökumətinin nüfuzlu \"Otto Monsted\" mükafatını qazanmışdır. Bu mükafatları qazanan ilk azərbaycanlı alimdir.","type":"text","version":1}],"direction":null,"format":"start","indent":0,"type":"listitem","version":1,"value":3},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"2022-ci ildə Azərbaycan Respublikasının Prezidenti İlham Əliyev tərəfindən \"Əməkdar elm xadimi\" fəxri adı ilə təltif edilmişdir.","type":"text","version":1}],"direction":null,"format":"start","indent":0,"type":"listitem","version":1,"value":4},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"2023-cü ildə Fields İnstitutunun ömürlük mükafatına (\"The Life Achievement Award\") layiq görülmüşdür.","type":"text","version":1}],"direction":null,"format":"start","indent":0,"type":"listitem","version":1,"value":5}],"direction":null,"format":"","indent":0,"type":"list","version":1,"listType":"bullet","start":1,"tag":"ul"},{"children":[],"direction":null,"format":"justify","indent":0,"type":"paragraph","version":1,"textFormat":0,"textStyle":""},{"children":[{"detail":0,"format":1,"mode":"normal","style":"","text":"Beynəlxalq Konfranslar və Tanınma","type":"text","version":1}],"direction":null,"format":"justify","indent":0,"type":"paragraph","version":1,"textFormat":1,"textStyle":""},{"children":[{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Onun 60 illik yubileyi münasibətilə Almaniyada (Münhen), 70 illik yubileyi isə Bakıda (dövlət səviyyəsində) beynəlxalq elmi konfranslarla qeyd olunmuşdur.","type":"text","version":1}],"direction":null,"format":"start","indent":0,"type":"listitem","version":1,"value":1},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Münhendə keçirilən konfransda 25 ölkədən 75 aparıcı alim iştirak etmişdir.","type":"text","version":1}],"direction":null,"format":"start","indent":0,"type":"listitem","version":1,"value":2},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Bakıda keçirilən konfransda isə 23 ölkədən 55 tanınmış alim qatılmışdır.","type":"text","version":1}],"direction":null,"format":"start","indent":0,"type":"listitem","version":1,"value":3},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"Professor Məsud Əfəndiyev, həm qazandığı nüfuzlu beynəlxalq mükafatlar, həm də onun şərəfinə təşkil olunan beynəlxalq konfranslarla tanınan, xaricdə yaşayan ilk azərbaycanlı alimdir.","type":"text","version":1}],"direction":null,"format":"start","indent":0,"type":"listitem","version":1,"value":4},{"children":[{"detail":0,"format":0,"mode":"normal","style":"","text":"35 ildən artıqdır ki, Almaniyada yaşayıb yaratsa da, Azərbaycan vətəndaşı olaraq qalır.","type":"text","version":1}],"direction":null,"format":"start","indent":0,"type":"listitem","version":1,"value":5}],"direction":null,"format":"","indent":0,"type":"list","version":1,"listType":"bullet","start":1,"tag":"ul"}],"direction":null,"format":"","indent":0,"type":"root","version":1}}